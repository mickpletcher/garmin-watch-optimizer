{
  "$defs": {
    "ApplyPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "merge",
          "enum": [
            "merge",
            "strict"
          ],
          "title": "Mode",
          "type": "string"
        },
        "backup_before_apply": {
          "const": true,
          "default": true,
          "title": "Backup Before Apply",
          "type": "boolean"
        },
        "verify_after_apply": {
          "const": true,
          "default": true,
          "title": "Verify After Apply",
          "type": "boolean"
        },
        "unsupported": {
          "default": "report",
          "enum": [
            "report",
            "block"
          ],
          "title": "Unsupported",
          "type": "string"
        },
        "require_confirmation_for_high_risk": {
          "const": true,
          "default": true,
          "title": "Require Confirmation For High Risk",
          "type": "boolean"
        }
      },
      "title": "ApplyPolicy",
      "type": "object"
    },
    "ConfigurationTarget": {
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "const": "Garmin",
          "default": "Garmin",
          "title": "Manufacturer",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "minimum_firmware": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Firmware"
        }
      },
      "required": [
        "models"
      ],
      "title": "ConfigurationTarget",
      "type": "object"
    },
    "JsonValue": {},
    "ProfileMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProfileMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/ProfileMetadata"
    },
    "target": {
      "$ref": "#/$defs/ConfigurationTarget"
    },
    "apply_policy": {
      "$ref": "#/$defs/ApplyPolicy"
    },
    "settings": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Settings",
      "type": "object"
    }
  },
  "required": [
    "profile",
    "target"
  ],
  "title": "DesiredConfiguration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mickpletcher/garmin-watch-optimizer/schemas/config.schema.json"
}
